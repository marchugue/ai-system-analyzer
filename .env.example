# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI provider — Groq (OpenAI-compatible chat completions API)
VITE_API_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
VITE_API_KEY=your-groq-api-key
# openai/gpt-oss-120b is Groq's current recommended general-purpose model
# (llama-3.3-70b-versatile is being retired — swap in any model from
# https://console.groq.com/docs/models if you'd rather use another one)
VITE_MODEL_NAME=openai/gpt-oss-120b
